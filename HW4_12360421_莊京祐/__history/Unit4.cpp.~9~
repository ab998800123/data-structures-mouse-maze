void __fastcall TForm4::Button3Click(TObject *Sender)
{
int u, v, i, j;
	String str="";
    position step;
	int mark[200][200];
	boolean found = false;
	Memo1->Lines->Add("m=" + IntToStr(m) + " n=" + IntToStr(n));

    // 初始化 mark 陣列
    for (i = 0; i < m; i++) {
        for (j = 0; j < n; j++) {
			mark[i][j] = 0;  // 未走過的區域
		}
	}

	// 設置起點和終點
	step.x = 1;
    step.y = 0;
	step.dir = 0;  // 開始向上移動
	push(step);
	while (top != -1) {
		step = pop();
		while (step.dir <= 7) {
            u = step.x + move[step.dir].dx;
			v = step.y + move[step.dir].dy;
			// 如果是有效的移動
			if (u >= 0 && u < m && v >= 0 && v < n && maze[u][v] == 0 && mark[u][v] == 0) {
				step.x = u;
				step.y = v;
				int x=step.dir;
				Memo1->Lines->Add(".. (u,v,dir)="+IntToStr(u)+","+IntToStr(v)+","+IntToStr(x));
				if ((u == m-2) && (v == n-1)){
					  found = true;
					  StringGrid1->Cells[n][m] = "&";
					  str = "("+IntToStr(step.x)+","+IntToStr(step.y)+")";
					  StringGrid1->Cells[step.y][step.x] = "->";
					  while (top != -1){
						step = pop();
						int x = step.dir;
						str = "("+IntToStr(step.x)+","+IntToStr(step.y)+","+IntToStr(x)+")-->"+str;
						StringGrid1->Cells[step.y][step.x] = "->";
						StringGrid1->Cells[0][1] = "->";
					  }
					  str = "(1,0,3)-->"+str;
					  Memo1->Lines->Add(str);
                      break;
				}
				else if ((maze[u][v]==0) && (mark[u][v]==0)){
					mark[u][v] = 1;
					StringGrid1->Cells[v][u] = "*";
					step.dir = step.dir+1;
					push(step);
					step.x = u; step.y = v; step.dir = 0;
				}
			}
			step.dir++;  // 嘗試下一個方向
		}
    }
}
