void __fastcall TForm4::Button2Click(TObject *Sender)
{
	int i, j;
	if (maze) {
		for (int i = 0; i < m; i++) delete[] maze[i];
		delete[] maze;
	}

	m = Edit1->Text.ToInt();
	n = Edit2->Text.ToInt();
	maze = new int*[m];
	for (int i = 0; i < m; i++) {
		maze[i] = new int[n];
	}

	int Start_i = 1, Start_j = 1, End_i = m - 2, End_j = n - 2;
	int x, y;
	srand(time(NULL));

	for (x = 0; x < m; x++) {
		for (y = 0; y < n; y++) {
			if (x == 0 || y == 0 || x == m - 1 || y == n - 1) {
				maze[x][y] = 2; // 边界
			}
			else {
                maze[x][y] = 1; // 內部
            }
        }
	}

    maze = generatemaze(maze, End_i, End_j);

    maze[Start_i][Start_j-1] = 0;
	maze[End_j][End_j+1] = 0;

    StringGrid1->RowCount = m;
    StringGrid1->ColCount = n;

    for (i = 0; i < m; i++) {
		for (j = 0; j < n; j++) {
            StringGrid1->Cells[j][i] = maze[i][j];
		}
	}
}

