#pragma package(smart_init)
#pragma resource "*.dfm"
TForm4 *Form4;

int **maze;
int m, n;

struct Direction {
    int dx;
    int dy;
};

struct position{
    int x, y;
    int dir;
};

Direction move[8];
position stack[10000];
int top = -1;


void push(position step) {
    top++;
	stack[top] = step;
}


position pop() {
	return stack[top--];
}



int **generatemaze(int **maze, int x, int y) {
    int direction;
    maze[x][y] = 0;
	while (maze[x][y+2] == 1 || maze[x+2][y] == 1 || maze[x][y-2] == 1 || maze[x-2][y] == 1) {
        direction = rand() % 4 + 1;
        if (direction == 1 && maze[x][y+2] == 1) {
            maze[x][y+1] = 0;
            maze = generatemaze(maze, x, y+2);
        }
        else if (direction == 2 && maze[x-2][y] == 1) {
            maze[x-1][y] = 0;
            maze = generatemaze(maze, x-2, y);
        }
        else if (direction == 3 && maze[x][y-2] == 1) {
            maze[x][y-1] = 0;
            maze = generatemaze(maze, x, y-2);
		}
		else if (direction == 4 && maze[x+2][y] == 1) {
            maze[x+1][y] = 0;
            maze = generatemaze(maze, x+2, y);
        }
    }
    return maze;
}

